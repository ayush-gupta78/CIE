{
  "name": "cie",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream -r dev",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/main.js --production",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:integration": "node scripts/integration-production.mjs",
    "dist:pack": "bash scripts/release-candidate.sh",
    "dist:verify": "bash scripts/verify-distribution.sh",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
